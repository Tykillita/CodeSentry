!/artifacts/decorations/prompts.json
!/artifacts/decorations/originals/
!/artifacts/decorations/preview.html
!/artifacts/decorations/preview.ts
/artifacts/decorations/originals/*
!/artifacts/decorations/originals/bark.png
!/artifacts/decorations/originals/petal.png
!/artifacts/decorations/originals/washi.png

