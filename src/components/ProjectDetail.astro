---
import type { CollectionEntry } from 'astro:content';
import { ui, areas, type Locale } from '../data/ui';
interface Props { project: CollectionEntry<'projects'>['data']; locale: Locale; }
const { project: p, locale } = Astro.props; const t = ui[locale]; const c = p[locale];
---
<div data-detail-content>
  <p class="eyebrow">{areas[p.area][locale]} <span class="detail-number">{String(p.order).padStart(2,'0')} / 16</span></p>
  <h2 class="detail-title">{c.title}</h2><p class="detail-subtitle">{c.subtitle}</p>
  <div class="detail-links">{p.links.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{t[link.type]} <span aria-hidden="true">↗</span></a>)}</div>
  <section><h3>{t.context}</h3><p>{c.context}</p></section>
  <section><h3>{t.features}</h3><ul class="feature-list">{c.features.map(f=><li>{f}</li>)}</ul></section>
  <section><h3>{t.flow}</h3><ol class="flow-list">{c.flow.map(f=><li>{f}</li>)}</ol></section>
  <section><h3>{t.architecture}</h3><p>{c.architecture}</p><div class="tags">{p.technologies.map(tech=><span>{tech}</span>)}</div></section>
  <section><h3>{t.decisions}</h3><ul>{c.decisions.map(d=><li>{d}</li>)}</ul></section>
  {c.credit && <section><h3>{t.credit}</h3><p>{c.credit}</p></section>}
  {c.note && <aside class="project-note"><h3>{t.note}</h3><p>{c.note}</p></aside>}
  {p.media.length>0 && <section class="detail-gallery"><h3>{t.gallery}</h3>{p.media.map((media,i)=><figure><img data-src={media[locale]} loading="lazy" decoding="async" alt={`${c.title} — ${t[media.type]} ${i+1}`} width="1200" height="800"/><noscript><img src={media[locale]} loading="lazy" alt={`${c.title} — ${t[media.type]}`} width="1200" height="800"/></noscript><figcaption>{t[media.type]}</figcaption></figure>)}</section>}
</div>
