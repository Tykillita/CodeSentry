---
// The brush-drawn arrow of the papyrus buttons. `id` keeps each copy's gradient, mask and filter apart.
interface Props { id:string }
const { id }=Astro.props;
---
<svg class="papyrus-arrow" viewBox="0 0 96 64" fill="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-ink`} x1="8" y1="32" x2="90" y2="32" gradientUnits="userSpaceOnUse">
      <stop stop-color="#765136" stop-opacity=".72"/>
      <stop offset=".28" stop-color="#4B3020" stop-opacity=".94"/>
      <stop offset=".64" stop-color="#68452D" stop-opacity=".86"/>
      <stop offset="1" stop-color="#3E291C"/>
    </linearGradient>
    <g id={`${id}-brush`}>
      <path d="M8 32.4C20 29.5 31 28.4 44 28.8C56 29.2 68 29.8 84 30.3L86 34.8C68 33.1 55 35 41 34.5C27 34.1 17 35.2 8.5 36.2L3.5 35.7 6.6 34.9 3.8 34.2 8.2 33.8 5.6 33.2Z"/>
      <path d="M54 11.6C65.9 15.1 76.6 22.8 91.6 29.8C93.4 30.7 93.4 32.6 91.7 33.9C80.2 43.1 68.3 50.7 53.9 54L56.3 51.1C67.8 45.8 77 39.4 84.1 33.5L81.9 32.4C72.2 25.9 62.1 19.6 54.8 14.3L52.8 11Z"/>
    </g>
    <filter id={`${id}-bleed`} x="-10%" y="-20%" width="120%" height="140%">
      <feGaussianBlur stdDeviation=".8"/>
    </filter>
    <mask id={`${id}-fibres`} maskUnits="userSpaceOnUse" x="0" y="0" width="96" height="64" style="mask-type:luminance">
      <path d="M0 0H96V64H0Z" fill="white"/>
      <g stroke="black" stroke-linecap="round" fill="none">
        <path d="M9 33.7 17 32.9M24 31.2 30 30.8M38 32.8 46 32.5M57 31.4 63 31.5M68 33 77 32.8" stroke-width=".9" opacity=".65"/>
        <path d="M60 15.6 65 18.8M73 23.2 79 27.2M69 46.5 74 42.9M83 37.4 89 32.8" stroke-width=".85" opacity=".65"/>
        <path d="M19.5 30.5 19 35.5M51 30 50.5 34M77.7 25.2 77 27.4M63 48 62.5 50.5" stroke-width=".45" opacity=".42"/>
      </g>
    </mask>
  </defs>
  <use href={`#${id}-brush`} fill="#805535" opacity=".24" filter={`url(#${id}-bleed)`}/>
  <use href={`#${id}-brush`} fill={`url(#${id}-ink)`} mask={`url(#${id}-fibres)`}/>
  <path d="M8 34.9 13 34.3M57.8 13.4 61.5 15.7M57.7 51 61.2 49.7" stroke="#916C47" stroke-width=".45" stroke-linecap="round" opacity=".58"/>
</svg>
