---
type ArrowDirection = 'up-right' | 'right' | 'left' | 'up' | 'down';
interface Props { direction?: ArrowDirection; class?: string; }
const { direction = 'up-right', class: className } = Astro.props;
---
<svg class:list={['arrow-icon', className]} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {direction === 'up-right' && <><path d="M4 12 12 4"/><path d="M6 4h6v6"/></>}
  {direction === 'right' && <><path d="M3 8h10"/><path d="m9 4 4 4-4 4"/></>}
  {direction === 'left' && <><path d="M13 8H3"/><path d="m7 4-4 4 4 4"/></>}
  {direction === 'up' && <><path d="M8 13V3"/><path d="m4 7 4-4 4 4"/></>}
  {direction === 'down' && <><path d="M8 3v10"/><path d="m4 9 4 4 4-4"/></>}
</svg>

<style>
  .arrow-icon { display:inline-block; width:1em; height:1em; flex:0 0 auto; overflow:visible; vertical-align:-.15em; }
</style>
