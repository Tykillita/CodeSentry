---
import type { Locale } from '../data/ui';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<div class="scroll-reader-control" role="slider" tabindex="-1" hidden
  aria-label={locale === 'es' ? 'Posición de lectura' : 'Reading position'}
  aria-controls="project-scroll-sheet" aria-describedby="scroll-reader-help"
  aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100"
  aria-valuenow="0" aria-disabled="true">
  <span id="scroll-reader-help" class="visually-hidden">{locale === 'es'
    ? 'Arrastra la tablilla de madera o pulsa el cordón para leer el pergamino. Flechas: un paso. Re Pág y Av Pág: una pantalla. Inicio y Fin: principio y final.'
    : 'Drag the wooden grip or press the cord to read the scroll. Arrow keys: one step. Page Up and Page Down: one screen. Home and End: beginning and end.'}</span>
  <svg class="scroll-reader-art" viewBox="0 0 44 900" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="reader-wood" x1="0" x2="1">
        <stop stop-color="#432d1d"/><stop offset=".18" stop-color="#a8774f"/>
        <stop offset=".44" stop-color="#806043"/><stop offset=".72" stop-color="#6e4a31"/>
        <stop offset="1" stop-color="#432d1d"/>
      </linearGradient>
      <clipPath id="reader-paper-shadow"><rect data-reader-shadow-clip width="30" height="900"/></clipPath>
      <filter id="reader-cast-shadow" x="-100%" y="-20%" width="300%" height="140%" filterUnits="userSpaceOnUse">
        <feGaussianBlur stdDeviation="1.3"/>
      </filter>
    </defs>
    <g clip-path="url(#reader-paper-shadow)">
      <path class="reader-cord-shadow" data-reader-cord d="M40 0V900" fill="none" stroke="#432d1d" stroke-opacity=".14" stroke-width="5" filter="url(#reader-cast-shadow)"/>
    </g>
    <path class="reader-cord-outline" data-reader-cord d="M40 0V900" fill="none" stroke="#8b7455" stroke-width="4.2"/>
    <path class="reader-cord-base" data-reader-cord d="M40 0V900" fill="none" stroke="#c8b38f" stroke-width="3.6"/>
    <path class="reader-cord-fibres" data-reader-fibre="dark" fill="none" stroke="#725739" stroke-opacity=".5" stroke-width=".7"/>
    <path class="reader-cord-fibres" data-reader-fibre="light" fill="none" stroke="#fff5df" stroke-opacity=".75" stroke-width=".7"/>
    <g class="reader-grip" data-reader-grip transform="translate(40 34)">
      <rect class="reader-hit" x="-40" y="-22" width="44" height="44" fill="transparent"/>
      <g data-reader-tilt>
        <g class="reader-wood">
          <path class="reader-wood-base" d="M-3.8-14.7Q-6.7-14.7-6.7-11L-5.8 11Q-5.8 14.7-3.2 14.7H3.2Q5.8 14.7 5.8 11L6.7-11Q6.7-14.7 3.8-14.7Z" fill="url(#reader-wood)" stroke="#432d1d" stroke-width=".6"/>
          <path class="reader-wood-side" d="M5-12 4.4 11Q4.4 13 2.8 13.7H-2.5L-3.2 14.3H3.2Q5.5 14.3 5.5 11L6.3-11Z" fill="#432d1d" fill-opacity=".5"/>
          <path class="reader-grain" d="M-3.9-12Q-5-3-3.8 3L-3.4 12M3.6-12Q2.5-4 3.5 3L3.2 12M-1-13Q-2-11-1.5-10M1 10Q.3 12 1 13" fill="none" stroke="#432d1d" stroke-opacity=".4" stroke-width=".5"/>
          <path class="reader-glint" d="M-5.6-10-4.8 10M-3.5-13.9H3" fill="none" stroke="#eadcc4" stroke-opacity=".45" stroke-width=".5"/>
          <path class="reader-grooves" d="M-3-2H3M-3 2H3" stroke="#432d1d" stroke-width="1.2" stroke-linecap="round"/>
          <path class="reader-glint" d="M-3-1.3H3M-3 2.7H3" stroke="#eadcc4" stroke-opacity=".3" stroke-width=".5"/>
          {[-7,7].map(y => <g class="reader-bore" data-reader-bore transform={`translate(0 ${y})`}>
            <ellipse rx="2.25" ry="2.8" fill="#302217"/>
            <path class="reader-glint" d="M-2 .5Q-1.5 2.7 0 2.8Q1.5 2.7 2 .5" fill="none" stroke="#c29568" stroke-width=".55"/>
            <path class="reader-bore-cord" d="M0-1.2V1.2" stroke="#c8b38f" stroke-width="2.7" stroke-linecap="round"/>
            <path class="reader-cord-fibres" d="M-.6-1.8 .6-.1-.5 1.7" stroke="#fff5df" stroke-opacity=".55" stroke-width=".55" fill="none"/>
          </g>)}
        </g>
        <path class="reader-binding" d="M-6-11Q0-9.5 6-11M5-10Q8-10 6.8-7.2Q4.5-8 5-10M5.5-9 7.2-5" fill="none" stroke="#d95c34" stroke-width=".85"/>
      </g>
    </g>
  </svg>
</div>
<svg class="reader-attachments" viewBox="0 0 44 900" preserveAspectRatio="none" aria-hidden="true" data-reader-hidden>
  <defs><linearGradient id="reader-anchor-linen" gradientUnits="userSpaceOnUse" x1="-5" x2="5" y1="0" y2="0">
    <stop stop-color="#8b7455"/><stop offset=".35" stop-color="#eadcc4"/><stop offset=".7" stop-color="#c8b38f"/><stop offset="1" stop-color="#a28b68"/>
  </linearGradient></defs>
  {['top','bottom'].map(side => <g data-reader-anchor={side}>
    <path class="reader-wrap-outline" data-reader-wrap fill="none" stroke="#6e543a" stroke-width="3.1" stroke-linecap="round"/>
    <path class="reader-wrap" data-reader-wrap fill="none" stroke="url(#reader-anchor-linen)" stroke-width="2.1" stroke-linecap="round"/>
    <g data-reader-knot>
      <path class="reader-wrap-outline" d="M-2.6-1Q2-3 3.1 0Q2 3-2.5 1.5Q-4 0-1.6-1.5L2 1.5M1.5 1 5.2 5" fill="none" stroke="#6e543a" stroke-width="2.9" stroke-linecap="round"/>
      <path class="reader-wrap" d="M-2.6-1Q2-3 3.1 0Q2 3-2.5 1.5Q-4 0-1.6-1.5L2 1.5M1.5 1 5.2 5" fill="none" stroke="#c8b38f" stroke-width="1.9" stroke-linecap="round"/>
      <path class="reader-wrap-highlight" d="M-2-1Q1.8-2 2.4-.2M-.8 1 1.5 1.6M2.4 2.4 4.3 4.1" fill="none" stroke="#f0e2c8" stroke-width=".55" stroke-linecap="round"/>
    </g>
  </g>)}
</svg>

<style is:global>
  .scroll-reader { position:relative;--reader-gap:3px; }
  .scroll-reader::before,.scroll-reader::after { content:'';position:absolute;z-index:1;top:0;bottom:0;width:13px;pointer-events:none;opacity:calc(var(--paper-edge,0)*.04);transform:perspective(100px) rotateY(calc(var(--paper-edge,0)*4deg)); }
  .scroll-reader::before { left:0;background:linear-gradient(90deg,#60442a99,transparent);transform-origin:left; }
  .scroll-reader::after { right:0;background:linear-gradient(270deg,#60442a99,transparent);transform-origin:right; }
  .scroll-reader[data-paper-moving]::before,.scroll-reader[data-paper-moving]::after { opacity:0; }
  .scroll-reader[data-paper-moving]>.scroll-sheet { overflow-y:hidden; }
  .paper-physics-screen { position:absolute;z-index:1;inset:0;pointer-events:none; }
  .paper-physics-camera { position:absolute;inset:0;perspective:1100px;perspective-origin:50% 50%; }
  .paper-physics-mesh { position:absolute;inset:0;transform-style:preserve-3d; }
  .paper-physics-band { position:absolute;top:0;left:0;width:100%;overflow:hidden;transform-origin:50% 0;backface-visibility:hidden; }
  .paper-physics-band::after { content:'';position:absolute;inset:0;background:linear-gradient(rgb(98 72 44 / var(--band-shade-top,0)),rgb(98 72 44 / var(--band-shade-bottom,0)));pointer-events:none; }
  .paper-physics-band .paper-band-viewport { margin:0;box-shadow:none; }
  .dialog-roller { background-position:0 var(--roller-light,0px); }
  .scroll-dialog[data-reader-ready] .scroll-sheet { scrollbar-width:none;padding-right:64px; }
  .scroll-dialog[data-reader-ready] .scroll-sheet::-webkit-scrollbar { display:none;width:0;height:0; }
  .scroll-dialog[data-reader-ready] .detail-title { overflow-wrap:anywhere; }
  .scroll-reader-control { position:absolute;z-index:0;top:0;bottom:0;right:calc(-1*(var(--reader-gap) + 4px));width:44px;touch-action:none;user-select:none;cursor:pointer;outline:none; }
  .reader-attachments { position:absolute;z-index:4;top:0;right:calc(-1*(var(--reader-gap) + 4px));width:44px;height:100%;overflow:visible;pointer-events:none; }
  .reader-attachments[data-reader-hidden] { display:none; }
  .scroll-reader-control[aria-disabled='true'] { pointer-events:none; }
  .scroll-reader-art { display:block;width:100%;height:100%;overflow:visible; }
  .reader-hit { cursor:grab; }
  .scroll-reader-control[data-dragging],.scroll-reader-control[data-dragging] .reader-hit { cursor:grabbing; }
  .scroll-reader-control[data-keyboard-focus]:not([data-pointer-focus]) .reader-wood-base { stroke:var(--red);stroke-width:1.6; }
  @media (min-width:1100px) { .scroll-reader { --reader-gap:10px; } }
  @media (max-width:600px) { .scroll-dialog[data-reader-ready] .scroll-sheet { padding-right:52px; } }
  @media (forced-colors:active) {
    .reader-cord-base,.reader-cord-outline,.reader-wrap-outline { stroke:CanvasText; }
    .reader-wrap { stroke:Canvas; }
    .reader-cord-shadow,.reader-cord-fibres,.reader-grain,.reader-glint,.reader-wrap-highlight,.reader-wood-side { display:none; }
    .reader-wood { filter:none; }
    .reader-wood-base { fill:Canvas;stroke:CanvasText;stroke-width:1.5; }
    .reader-grooves,.reader-binding { stroke:CanvasText; }
    .reader-bore ellipse { fill:CanvasText; }
    .reader-bore-cord { stroke:Canvas; }
    .scroll-reader-control[data-keyboard-focus]:not([data-pointer-focus]) .reader-wood-base { stroke:Highlight; }
  }
</style>
